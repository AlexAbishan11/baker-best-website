# ============================================
# .gitignore for BakerBest Project
# ============================================

# ---------- Environment & Config ----------
.env
config/.env
*.env

# ---------- IDE / Editor Files ----------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ---------- Operating System Files ----------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------- Logs & Error Files ----------
*.log
logs/
error_log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- Dependencies (if any) ----------
node_modules/
vendor/
composer.lock

# ---------- Temporary Files ----------
*.tmp
*.temp
*.bak
*.swp
*~
.cache/

# ---------- Uploads (temporary) ----------
uploads/temp/
temp/
tmp/

# ---------- WampServer Specific ----------
*.pid
*.err

# ---------- Compiled Files ----------
*.pyc
__pycache__/